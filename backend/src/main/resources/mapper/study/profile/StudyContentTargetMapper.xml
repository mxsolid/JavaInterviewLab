<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javainterviewlab.study.profile.repository.StudyContentTargetMapper">
    <select id="countEnabledQuestionById" resultType="int">
        SELECT COUNT(1) FROM question WHERE id = #{targetId} AND status = 'ENABLED'
    </select>
    <select id="countEnabledTopicById" resultType="int">
        SELECT COUNT(1) FROM topic WHERE id = #{targetId} AND status = 'ENABLED'
    </select>
</mapper>
