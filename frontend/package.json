{
  "name": "java-interview-lab-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "openapi:fetch": "node scripts/fetch-openapi.mjs",
    "openapi:generate": "openapi-typescript openapi/openapi.json -o src/api/generated/schema.ts",
    "bundle:report": "node scripts/analyze-bundle.mjs",
    "performance": "npm run build && npm run bundle:report",
    "screenshot:shell": "playwright test e2e/shell.visual.spec.ts --project=chromium",
    "e2e": "playwright test --project=chromium",
    "test": "vitest run src",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@tanstack/react-query": "^5.90.0",
    "antd": "^6.0.0",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  }
}
